{
  "name": "mini-drifters",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A tiny browser-based arcade drifting game. Slide through corners, chain drifts, and chase your best score.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:records:browser": "node test/records-browser.mjs",
    "test:controller:browser": "node test/controller-browser.mjs",
    "test:browser": "node test/browser-check.mjs",
    "test:audio:browser": "node test/audio-lab-browser.mjs",
    "test:coyote:browser": "node test/coyote-browser.mjs",
    "test:gameplay-audio:browser": "node test/gameplay-audio-browser.mjs",
    "test:ghost:browser": "node test/ghost-browser.mjs",
    "test:menus:browser": "node test/menus-browser.mjs",
    "test:radio:browser": "node test/radio-browser.mjs",
    "test:tutorial:browser": "node test/tutorial-browser.mjs",
    "test:tracks:browser": "node test/tracks-browser.mjs",
    "test:scoring:browser": "node test/scoring-browser.mjs"
  }
}
